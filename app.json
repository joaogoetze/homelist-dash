{
  "expo": {
    "name": "homelist-dash",
    "slug": "homelist-dash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "homelistdash",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joaogoetze.homelistdash"
    },

    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.joaogoetze.homelistdash"
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "0356aaac-3ca1-44d2-95ca-0bf354667174"
      }
    }
  }
}